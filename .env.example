# Copy to .env. Read once at startup by src/lib/env.ts (zod-validated).

# --- Database ---
POSTGRES_USER=canvas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=canvas_chat
# Host port for Postgres (5433 avoids clashing with a locally installed Postgres on 5432).
POSTGRES_HOST_PORT=5433
# Inside Compose the host is "postgres"; for `pnpm dev` on the host use localhost.
DATABASE_URL=postgres://canvas:change-me@localhost:5433/canvas_chat

# --- LLM ---
# Not needed when MOCK_LLM=1. Set a spend limit on this key at openrouter.ai.
OPENROUTER_API_KEY=
# Any OpenRouter model ids (see openrouter.ai/models). Comma-separated list shown in the model picker.
ALLOWED_MODELS=
# Must be one of ALLOWED_MODELS.
DEFAULT_MODEL=
# Cheaper model for titles and quick actions. Must be one of ALLOWED_MODELS.
TASK_MODEL=

# --- Testing ---
# 1 = scripted mock model + /api/test/reset enabled. Never set in real use.
MOCK_LLM=1
# In mock mode, ALLOWED_MODELS falls back to: mock/alpha,mock/beta (DEFAULT_MODEL=mock/alpha, TASK_MODEL=mock/alpha)
# Set to 1 to run the real-model @smoke suite.
RUN_SMOKE=0

# --- Server ---
# Bind to localhost only; v1 has no login.
HOST=127.0.0.1
PORT=3000
